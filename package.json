{
  "name": "dsh-plugin-file-events",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: folder-change event triggers. Each watch rule binds a workspace and one or more watched paths; when files change there (debounced), a fresh agent session starts on its own — no live chat session required. Rules may pick an agent preset, an ordered model chain with fallback, and an allowedProviders allowlist (e.g. local-only). Includes a management API and full-page UI.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "watch",
    "file-events",
    "file-watcher",
    "trigger",
    "event",
    "model-chain",
    "fallback",
    "agent-preset"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "minimatch": "^9.0.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
